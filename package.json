{
  "name": "fabpay",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "cd packages/db && yarn prisma generate && cd ../../",
    "start-docker": "docker desktop start",
    "start-user-app": "docker start pg-dev && cd ./apps/user-app && yarn start"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "turbo": "^2.9.16",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
